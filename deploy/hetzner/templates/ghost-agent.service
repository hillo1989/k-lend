# GHOST-Agent im Mainnet (von deploy/hetzner/setup.sh aus der Vorlage erzeugt).
# Orakel (Unterzeichner-Datei), Zinsregel, Liquidationen, Auflösen, Tresore.
# Gebühren und Liquidationen zahlt der Keeper-Schlüssel (--key), Preise
# signiert die Unterzeichner-Datei (--committee). Der Besitzer-Schlüssel
# (keys/mainnet-owner.json) liegt NICHT auf dem Server.
#
# WICHTIG: Läuft dieser Dienst, muss der Agent auf dem Mac aus bleiben
# (sonst streiten beide um dieselben UTXOs).
#
# Rechtemodell (Audit 20 A20c-3, README „Benutzer und Rechte“): Der Agent ist
# der einzige Dienst als Benutzer ghost und damit der einzige, der keys/
# (700 ghost) lesen kann. Die Seite läuft als ghost-web und teilt mit ihm nur
# deployments/ (2770 ghost:ghost); neue Dateien deshalb 660 (UMask 0007).
[Unit]
Description=GHOST-Agent (Kaspa-Mainnet)
Wants=network-online.target
After=network-online.target
# keine Endlosschleife bei dauerhaftem Fehler: höchstens 10 Starts in 10 Minuten
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
User=ghost
Group=ghost
WorkingDirectory=@GHOST_DIR@
ExecStart=@GHOST_DIR@/vendor/silverscript/target/release/ghostctl --network mainnet --state deployments/mainnet.json --ja agent --key keys/mainnet-keeper.json --committee keys/mainnet-signer.json --interval 300 --min-change 0.005 --max-age-min 60
Restart=always
RestartSec=30
# Ein Abbruch mitten im Senden ist abgesichert: ghostctl klärt offene
# Sendungen beim nächsten Start über sein Journal (store::resolve_pending).
TimeoutStopSec=30

# Härtung: Schreiben nur in deployments/, alles andere schreibgeschützt
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=@GHOST_DIR@/deployments
# Was in deployments/ oder /tmp liegt, ist nie ausführbar
NoExecPaths=@GHOST_DIR@/deployments /tmp /var/tmp /dev/shm
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
# fremde Prozesse (Seite) in /proc unsichtbar; die Seite sieht den Agenten ebenso nicht
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
KeyringMode=private
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @obsolete
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
# 660 statt 600: die Seite (Gruppe ghost) muss Zustand, Sperren und Journal
# lesen und fortschreiben können; keys/ bleibt 700 und wird hier nie beschrieben
UMask=0007

[Install]
WantedBy=multi-user.target
