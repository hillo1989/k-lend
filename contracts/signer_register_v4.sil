pragma silverscript ^0.1.0; // Sprachversion des Compilers v1.0.0 ist 0.1.0 (compiler/mod.rs:55)

// SignerRegisterV4 — Unterzeichner-Register für das Preis-Orakel v4.
//
// Der Unterzeichner-Satz steht nur als Hash im Zustand:
//   setHash = sha256(n ‖ t ‖ tRot ‖ k0 ‖ … ‖ k(n−1)),  Zahlen je 8 Byte
// n Schlüssel, Preis-Schwelle t, Austausch-Schwelle tRot. Die Schlüssel kommen
// bei jedem Eintrag als Argument mit. fbHash ist der Notfallsatz in derselben
// Form; fbHash = 0…0 heißt „kein Notfallsatz“ (dazu gibt es kein Urbild).
//
// Zwei Arten von UTXOs tragen die Covenant-ID des Registers:
//   Haupt-UTXO  (isTicket = false), genau eine, Singleton.
//   Ticket      (isTicket = true), entsteht bei propose und trägt den
//               angekündigten Satz, den Notfallsatz und das Zinsziel.
// Die Wartezeit eines Austauschs prüft das Ticket selbst mit this.ageDaa:
// Die relative Sperre zählt ab der Aufnahme des Tickets in die Kette und lässt
// sich weder zurückdatieren noch durch Updates zurücksetzen (anders als ein
// Zustandswert, den die Vorschlagenden wählen, AUDIT.md NEU-1). Ein Ticket gilt
// nur, solange seine nonce der nonce der Haupt-UTXO entspricht; cancel,
// activate, ein neuer Vorschlag und – bei Notfall-Tickets – jedes Preis-Update
// erhöhen die nonce und entwerten es.
//
// Sicherheitsregeln (vgl. docs/v4-entwurf.md):
//   - Nur attestPrice darf mit einem Orakel-Eingang in derselben Tx stehen
//     und verlangt dann den signierten Orakel-Ausgang. Jeder andere Eintrag
//     verbietet den Orakel-Eingang (noOracle), damit kein Orakel-Update ohne
//     Preis-Signaturen durchgeht.
//   - Die Haupt-UTXO setzt sich genau einmal fort (OpAuthOutputIdx des eigenen
//     Eingangs), mit gleichem KAS-Betrag; ein Ticket erzeugt keine Ausgänge.
//   - Ein lebendes Ticket lässt sich nur verbrauchen, wenn die Haupt-UTXO in
//     derselben Tx genau den aktivierten Zustand erzeugt; zu früh oder in einer
//     fremden Tx scheitert es. Abgelaufene Tickets darf jeder aufräumen.
//
// Zinsziel (payKind, payTo): wohin die Zinskasse (zinskasse_v4.sil) weiterleitet.
//   payKind 0 = P2PK (payTo = x-only-Pubkey), 1 = P2SH (payTo = Skript-Hash,
//   z. B. ein späterer Topf oder eine unspendbare Adresse zum Verbrennen),
//   sonst = Kasse hält das Geld fest. Änderung nur über propose/activate.
contract SignerRegisterV4(
    pubkey deployer,      // nur für init (einmalig), danach ohne Rechte
    int minSigners,       // kleinstes n eines Satzes (Vorschlag 5; Alleinbetrieb 1)
    int minThreshold,     // kleinstes t eines Satzes (Vorschlag 3; Alleinbetrieb 1)
    int rotDelayDaa,      // Wartezeit regulärer Austausch (Vorschlag 14 Tage = 12_096_000)
    int emergAfterDaa,    // Stille, ab der der Notfallsatz vorschlagen darf (Vorschlag 30 Tage = 25_920_000)
    int emergDelayDaa,    // Wartezeit Notfall-Austausch (Vorschlag 14 Tage = 12_096_000)
    bool initTicket, byte[32] initSetHash, byte[32] initFbHash, byte initPayKind, byte[32] initPayTo,
    int initNonce, bool initEmerg, int initLastDaa,
    byte[32] initOracleCov, byte[32] initOracleTpl, int initOraclePrefixLen, int initOracleSuffixLen,
    bool initInitialized
) {
    bool isTicket = initTicket;
    byte[32] setHash = initSetHash;       // Ticket: angekündigter Satz
    byte[32] fbHash = initFbHash;         // Ticket: angekündigter Notfallsatz
    byte payKind = initPayKind;           // Ticket: angekündigtes Zinsziel
    byte[32] payTo = initPayTo;
    int nonce = initNonce;
    bool emerg = initEmerg;               // Haupt: Notfall-Ticket offen; Ticket: ist Notfall-Ticket
    int lastDaa = initLastDaa;            // oracleDaa des letzten Preis-Updates
    byte[32] oracleCov = initOracleCov;   // per init gesetzt
    byte[32] oracleTpl = initOracleTpl;
    int oraclePrefixLen = initOraclePrefixLen;
    int oracleSuffixLen = initOracleSuffixLen;
    bool initialized = initInitialized;

    // muss der State-Anordnung von price_oracle_v4.sil entsprechen
    struct OracleState {
        int kasUsd;
        int oracleDaa;
        int seq;
        int stableRate;
        int stableIndex;
        bool frozen;
        int lastRateDaa;
    }

    // Mempool-Standardregel: höchstens 15 Signaturprüfungen je Eingang, statisch
    // im ganzen Skript gezählt (rusty-kaspa MAX_STANDARD_P2SH_SIG_OPS). checkQuorum
    // steht in drei Einträgen und wird je MAX_QUORUM-mal ausgerollt, dazu checkSig
    // in init: 3 · 4 + 1 = 13. Mit 9 lag das Register bei 28 und wurde im
    // Mainnet abgelehnt (Probe 05.10.2026). Aus 2t > n und t ≤ 4 folgt n ≤ 7.
    int constant MAX_SIGNERS = 7;
    int constant MAX_QUORUM = 4;
    byte constant TAG_PRICE = 0x01;
    byte constant TAG_ROTATE = 0x02;
    byte constant TAG_CANCEL = 0x03;
    byte constant TAG_EMERG = 0x04;

    function myValue(): int {
        return tx.inputs[this.activeInputIndex].value;
    }

    // Haupt-UTXO setzt sich genau einmal mit gleichem Betrag fort.
    function cont(): int {
        require(OpAuthOutputCount(this.activeInputIndex) == 1);
        int outIdx = OpAuthOutputIdx(this.activeInputIndex, 0);
        require(tx.outputs[outIdx].value == myValue());
        return outIdx;
    }

    function live() {
        require(!isTicket);
        require(initialized);
    }

    // kein Orakel-Eingang in dieser Tx (Umgehungsschutz)
    function noOracle() {
        require(OpCovInputCount(oracleCov) == 0);
    }

    // Grenzen eines Satzes: minSigners ≤ n ≤ 7, t ≥ minThreshold, echte
    // Mehrheit 2t > n, t ≤ tRot ≤ n, tRot ≤ 4
    function checkBounds(int n, int t, int tRot) {
        require(n >= minSigners);
        require(n <= MAX_SIGNERS);
        require(t >= minThreshold);
        require(2 * t > n);
        require(tRot >= t);
        require(tRot <= n);
        require(tRot <= MAX_QUORUM);
    }

    function hashSet(int n, int t, int tRot, pubkey[] keys): byte[32] {
        require(keys.length == n);
        // Schleifengrenze ausdrücklich prüfen (TUTORIAL: nicht auf die
        // Laufzeitprüfung des Compilers verlassen)
        require(n <= MAX_SIGNERS);
        byte[] acc = byte[](n as byte[8]) + byte[](t as byte[8]) + byte[](tRot as byte[8]);
        for(i, 0, n, MAX_SIGNERS) {
            acc = acc + byte[](keys[i]);
        }
        return sha256(acc);
    }

    // need Signaturen über digest, Schlüsselindizes streng aufsteigend
    // (kein Schlüssel zählt doppelt) und < n
    function checkQuorum(byte[32] digest, int need, int n, pubkey[] keys, datasig[] sigs, int[] idx) {
        require(sigs.length == need);
        require(idx.length == need);
        require(need <= MAX_QUORUM);
        int last = -1;
        for(k, 0, need, MAX_QUORUM) {
            int j = idx[k];
            require(j > last);
            require(j < n);
            require(checkMsgSig(sigs[k], digest, keys[j]));
            last = j;
        }
    }

    // ---------------------------------------------------------------- Einträge

    // Einmalig, vom Deployer signiert: Orakel-Covenant und -Template festlegen
    // (das Orakel kennt die Register-ID als Konstante, darum erst nach dessen
    // Genesis). Prüft dabei den Startsatz gegen die Grenzen.
    entry init(int n, int t, int tRot, pubkey[] keys, byte[32] oCov, byte[32] oTpl, int oPre, int oSuf, sig s) {
        require(!isTicket);
        require(!initialized);
        require(checkSig(s, deployer));
        checkBounds(n, t, tRot);
        require(hashSet(n, t, tRot, keys) == setHash);
        require(OpCovInputCount(oCov) == 0);
        int o = cont();
        validateOutputState(o, State {
            isTicket: false, setHash: setHash, fbHash: fbHash, payKind: payKind, payTo: payTo,
            nonce: nonce, emerg: emerg, lastDaa: lastDaa,
            oracleCov: oCov, oracleTpl: oTpl, oraclePrefixLen: oPre, oracleSuffixLen: oSuf, initialized: true
        });
    }

    // Preis-Update: t Unterzeichner des aktuellen Satzes signieren
    // sha256(oracleCov ‖ 0x01 ‖ kasUsd ‖ oracleDaa ‖ seq ‖ stableRate). Der
    // Orakel-Ausgang muss genau diesen Zustand tragen; Index und lastRateDaa
    // rechnet das Orakel selbst nach (seine eigene update-Prüfung).
    // Ein offenes Notfall-Ticket verfällt: das Update beweist, dass der
    // Hauptsatz lebt.
    entry attestPrice(int newKasUsd, int newDaa, int newSeq, int newRate, int newIndex, int newRateDaa,
                      int n, int t, int tRot, pubkey[] keys, datasig[] sigs, int[] idx) {
        live();
        require(hashSet(n, t, tRot, keys) == setHash);
        byte[] m = byte[](oracleCov) + byte[](TAG_PRICE)
            + byte[](newKasUsd as byte[8]) + byte[](newDaa as byte[8])
            + byte[](newSeq as byte[8]) + byte[](newRate as byte[8]);
        checkQuorum(sha256(m), t, n, keys, sigs, idx);
        int oIn = OpCovInputIdx(oracleCov, 0);
        require(OpCovOutputCount(oracleCov) == 1);
        validateOutputStateWithInputTemplate(
            OpCovOutputIdx(oracleCov, 0),
            OracleState {
                kasUsd: newKasUsd, oracleDaa: newDaa, seq: newSeq, stableRate: newRate,
                stableIndex: newIndex, frozen: false, lastRateDaa: newRateDaa
            },
            oIn, oraclePrefixLen, oracleSuffixLen, oracleTpl
        );
        int newNonce = nonce;
        if (emerg) {
            newNonce = nonce + 1;
        }
        int o = cont();
        validateOutputState(o, State {
            isTicket: false, setHash: setHash, fbHash: fbHash, payKind: payKind, payTo: payTo,
            nonce: newNonce, emerg: false, lastDaa: newDaa,
            oracleCov: oracleCov, oracleTpl: oracleTpl, oraclePrefixLen: oraclePrefixLen,
            oracleSuffixLen: oracleSuffixLen, initialized: true
        });
    }

    // Ankündigung eines neuen Satzes (mit Notfallsatz und Zinsziel).
    //   isEmerg = false: tRot des aktuellen Satzes; Wartezeit rotDelayDaa.
    //   isEmerg = true:  tRot des Notfallsatzes, nur nach emergAfterDaa ohne
    //                    Preis-Update; Wartezeit emergDelayDaa.
    // Signiert wird sha256(regCov ‖ Tag ‖ nonce+1 ‖ Ankündigung). Der Payload
    // der Tx muss genau die Ankündigung sein (newSet ‖ newFb ‖ newKind ‖ newTo),
    // die neuen Schlüssel stehen im Sigscript: der Austausch ist öffentlich.
    // Es entsteht ein Ticket; die Haupt-UTXO behält ihren Satz.
    entry propose(int newN, int newT, int newTRot, pubkey[] newKeys, byte[32] newFb, byte newKind, byte[32] newTo,
                  bool isEmerg, int n, int t, int tRot, pubkey[] keys, datasig[] sigs, int[] idx) {
        live();
        noOracle();
        checkBounds(newN, newT, newTRot);
        byte[32] newSet = hashSet(newN, newT, newTRot, newKeys);
        byte[32] auth = setHash;
        byte tag = TAG_ROTATE;
        if (isEmerg) {
            require(tx.daa >= lastDaa + emergAfterDaa);
            // der Notfallsatz steht nur als Hash im Zustand: Grenzen hier prüfen
            checkBounds(n, t, tRot);
            auth = fbHash;
            tag = TAG_EMERG;
        }
        require(hashSet(n, t, tRot, keys) == auth);
        int newNonce = nonce + 1;
        byte[] ann = byte[](newSet) + byte[](newFb) + byte[](newKind) + byte[](newTo);
        require(OpTxPayloadSubstr(0, OpTxPayloadLen()) == ann);
        byte[] m = byte[](OpInputCovenantId(this.activeInputIndex)) + byte[](tag) + byte[](newNonce as byte[8]) + ann;
        checkQuorum(sha256(m), tRot, n, keys, sigs, idx);
        require(OpAuthOutputCount(this.activeInputIndex) == 2);
        int o = OpAuthOutputIdx(this.activeInputIndex, 0);
        require(tx.outputs[o].value == myValue());
        validateOutputState(o, State {
            isTicket: false, setHash: setHash, fbHash: fbHash, payKind: payKind, payTo: payTo,
            nonce: newNonce, emerg: isEmerg, lastDaa: lastDaa,
            oracleCov: oracleCov, oracleTpl: oracleTpl, oraclePrefixLen: oraclePrefixLen,
            oracleSuffixLen: oracleSuffixLen, initialized: true
        });
        validateOutputState(OpAuthOutputIdx(this.activeInputIndex, 1), State {
            isTicket: true, setHash: newSet, fbHash: newFb, payKind: newKind, payTo: newTo,
            nonce: newNonce, emerg: isEmerg, lastDaa: lastDaa,
            oracleCov: oracleCov, oracleTpl: oracleTpl, oraclePrefixLen: oraclePrefixLen,
            oracleSuffixLen: oracleSuffixLen, initialized: true
        });
    }

    // Rücknahme einer Ankündigung (auch einer Notfall-Ankündigung) durch t des
    // aktuellen Satzes: nonce + 1 entwertet jedes offene Ticket.
    entry cancel(int n, int t, int tRot, pubkey[] keys, datasig[] sigs, int[] idx) {
        live();
        noOracle();
        require(hashSet(n, t, tRot, keys) == setHash);
        int newNonce = nonce + 1;
        byte[] m = byte[](OpInputCovenantId(this.activeInputIndex)) + byte[](TAG_CANCEL) + byte[](newNonce as byte[8]);
        checkQuorum(sha256(m), t, n, keys, sigs, idx);
        int o = cont();
        validateOutputState(o, State {
            isTicket: false, setHash: setHash, fbHash: fbHash, payKind: payKind, payTo: payTo,
            nonce: newNonce, emerg: false, lastDaa: lastDaa,
            oracleCov: oracleCov, oracleTpl: oracleTpl, oraclePrefixLen: oraclePrefixLen,
            oracleSuffixLen: oracleSuffixLen, initialized: true
        });
    }

    // Jeder darf ein fälliges Ticket in Kraft setzen. Die Wartezeit prüft das
    // Ticket selbst (settle, this.ageDaa); hier: lebendes Ticket derselben
    // Covenant, Satz, Notfallsatz und Zinsziel übernehmen, nonce + 1.
    entry activate(int ticketIdx) {
        live();
        noOracle();
        require(OpInputCovenantId(ticketIdx) == OpInputCovenantId(this.activeInputIndex));
        State tk = readInputState(ticketIdx);
        require(tk.isTicket);
        require(tk.nonce == nonce);
        int o = cont();
        validateOutputState(o, State {
            isTicket: false, setHash: tk.setHash, fbHash: tk.fbHash, payKind: tk.payKind, payTo: tk.payTo,
            nonce: nonce + 1, emerg: false, lastDaa: lastDaa,
            oracleCov: oracleCov, oracleTpl: oracleTpl, oraclePrefixLen: oraclePrefixLen,
            oracleSuffixLen: oracleSuffixLen, initialized: true
        });
    }

    // Jeder darf die Haupt-UTXO unverändert ausgeben, damit die Zinskasse das
    // Zinsziel lesen kann (zinskasse_v4.sil). Kein Orakel in der Tx.
    entry witness() {
        live();
        noOracle();
        int o = cont();
        validateOutputState(o, State {
            isTicket: false, setHash: setHash, fbHash: fbHash, payKind: payKind, payTo: payTo,
            nonce: nonce, emerg: emerg, lastDaa: lastDaa,
            oracleCov: oracleCov, oracleTpl: oracleTpl, oraclePrefixLen: oraclePrefixLen,
            oracleSuffixLen: oracleSuffixLen, initialized: true
        });
    }

    // Ticket ausgeben. Die Haupt-UTXO muss in derselben Tx stehen (mainIdx).
    //   lebend (gleiche nonce): erst nach der Wartezeit, und nur wenn die
    //     Haupt-UTXO genau den aktivierten Zustand erzeugt;
    //   abgelaufen: frei (Aufräumen).
    // Ein Ticket erzeugt keine Ausgänge der Register-Covenant. Ein Orakel-Update
    // kann neben einem Ticket nie stehen: das Orakel verlangt genau einen
    // Register-Eingang, settle aber zwei (Ticket und Haupt-UTXO).
    entry settle(int mainIdx) {
        require(isTicket);
        require(OpAuthOutputCount(this.activeInputIndex) == 0);
        require(OpInputCovenantId(mainIdx) == OpInputCovenantId(this.activeInputIndex));
        State mn = readInputState(mainIdx);
        require(!mn.isTicket);
        if (mn.nonce == nonce) {
            int delay = rotDelayDaa;
            if (emerg) {
                delay = emergDelayDaa;
            }
            require(this.ageDaa >= delay);
            validateOutputState(OpAuthOutputIdx(mainIdx, 0), State {
                isTicket: false, setHash: setHash, fbHash: fbHash, payKind: payKind, payTo: payTo,
                nonce: nonce + 1, emerg: false, lastDaa: mn.lastDaa,
                oracleCov: oracleCov, oracleTpl: oracleTpl, oraclePrefixLen: oraclePrefixLen,
                oracleSuffixLen: oracleSuffixLen, initialized: true
            });
        }
    }
}
