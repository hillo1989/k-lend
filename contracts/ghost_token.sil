pragma silverscript ^0.1.0; // Sprachversion des Compilers v1.0.0 ist 0.1.0 (compiler/mod.rs:55)

// GhostToken — der GHOST-Stablecoin als KCC20-Token.
//
// Grundlage: vendor/silverscript/silverscript-lang/tests/examples/kcc20.sil
// (SilverScript v1.0.0, ISC-Lizenz), mit EINER Änderung:
//
//   Jeder neue Zustand muss amount >= 0 haben.
//
// Das Original prüft nur totalIn == totalOut. Damit ließ sich 1 Einheit in
// [+D, -(D-1)] aufteilen und beliebig viel GHOST erzeugen (Audit 1, V-01,
// 28.09.2026, belegt gegen die echte Engine). Da kein Zustand negativ werden
// kann und die Genesis bei 0 beginnt, sind auch alle Eingänge >= 0.

contract KCC20(byte[32] genesisPk, int genesisAmount, byte genesisIdentifierType, bool genesisIsMinter, int maxCovIns, int maxCovOuts) {
    byte constant IDENTIFIER_PUBKEY = 0x00;
    byte constant IDENTIFIER_SCRIPT_HASH = 0x01;
    byte constant IDENTIFIER_COVENANT_ID = 0x02;
    
    byte[32] ownerIdentifier = genesisPk;
    byte identifierType = genesisIdentifierType;
    int amount = genesisAmount;
    bool isMinter = genesisIsMinter;

    function checkInputSig(sig s, byte witness) {
        if(identifierType == IDENTIFIER_PUBKEY){
            require(checkSig(s, pubkey(ownerIdentifier)));
        } else if(identifierType == IDENTIFIER_SCRIPT_HASH){
            byte[] spk = byte[](new ScriptPubKeyP2SH(ownerIdentifier));
            require(tx.inputs[unsigned(witness)].scriptPubKey == spk);
        } else if(identifierType == IDENTIFIER_COVENANT_ID){
            require(OpCovInputCount(ownerIdentifier) > 0);
        } else {
            require(false);
        }
    }

    function checkAmounts(State[] prevStates, State[] newStates) {
        if(!isMinter){
            int totalIn = 0;
            for(i, 0, prevStates.length, maxCovIns) {
                totalIn = totalIn + prevStates[i].amount;
            }

            int totalOut = 0;
            for(i, 0, newStates.length, maxCovOuts) {
                totalOut = totalOut + newStates[i].amount;
            }

            require(totalIn == totalOut);
        }
    }

    // Audit 1 V-01: keine negativen Beträge, auch nicht für Minter-Zweige
    function checkNonNegative(State[] newStates) {
        for(i, 0, newStates.length, maxCovOuts) {
            require(newStates[i].amount >= 0);
        }
    }

    function checkMintingTransfer(State[] newStates){
        if(!isMinter){
            for(i, 0, newStates.length, maxCovOuts) {
                require(!newStates[i].isMinter);
            }
        }
    }

    #[covenant(binding = cov, from = maxCovIns, to = maxCovOuts)]
    function transfer(State[] prevStates, State[] newStates, sig s, byte witness) {
        checkInputSig(s, witness);
        checkNonNegative(newStates);
        checkAmounts(prevStates, newStates);
        checkMintingTransfer(newStates);
    }

    #[covenant.delegate]
    function authorizeDelegate(sig s, byte witness) {
        checkInputSig(s, witness);
    }
}
