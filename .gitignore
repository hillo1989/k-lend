.DS_Store
# Private Schlüssel – niemals committen
keys/
*.json.tmp
deployments/*skripttest*
# Laufzeitdateien von ghostctl (Fix-Review 8, NEU-7)
deployments/*.lock
deployments/*.tmp
app/tsconfig.tsbuildinfo
# Daueraufträge und lokaler Verlauf: persönliche Daten (Empfänger, Nachrichten)
deployments/*-abos.json
deployments/*-txlog.jsonl
# Zinsregel des Agenten (Messungen, letzte Zinsänderung) und Sperre des Umzugs
deployments/*-zins.json
deployments/.umzug-v3.lock/
# Programme älterer Versionen für den Abbau (lokal gebaut, nicht committen)
bin/ghostctl-v2
bin/ghostctl-v3
deployments/.umzug-v4.lock/
# vom Server-Setup erzeugte Webserver-Blöcke (deploy/hetzner/setup.sh)
deploy/hetzner/generated/
# Zustand, Tresore, Zinsregel, Journale und Sperren des Betriebs (Audit 20
# A20c-6): Besucher-Tresore enthalten Empfänger, Beträge und Nachrichten.
# Alles unter deployments/ bleibt lokal; nur die Kettendaten der ersten
# Version sind öffentlich und getrackt (Ausnahmen unten).
deployments/*
!deployments/mainnet-v1.json
!deployments/testnet-10-v1.json
# auch außerhalb von deployments/ nie mitnehmen
*-tresore.json
*-zins.json
*-abos.json
*-txlog.jsonl
*.pending.json
